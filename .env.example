# Шаблон окружения. Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore) — там настоящие секреты.

# Режим работы. В production приложение не стартует без SESSION_SECRET и
# ADMIN_PASSWORD_HASH, а cookie получают флаг Secure (сайт за HTTPS).
NODE_ENV=development

# Порт, который слушает Node.
PORT=3000

# Строка подключения к PostgreSQL (обязательна).
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ
DATABASE_URL=postgresql://postgres:ПАРОЛЬ@localhost:5432/mas_eka

# Необязательно: поставьте "require", если провайдер БД (Render, Railway,
# Supabase и т.п.) требует TLS-соединение с самоподписанным сертификатом.
# DATABASE_SSL=require

# Публичный URL сайта (без слэша в конце) — для sitemap, Open Graph и canonical.
# Если не задан, берётся из заголовков запроса (подходит для локальной работы).
# SITE_URL=https://ваш-домен.ru

# Длинная случайная строка для подписи cookie, минимум 16 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=замените-на-длинную-случайную-строку

# Логин администратора блога.
ADMIN_LOGIN=admin

# bcrypt-хэш пароля администратора. Получить:
#   npm run hash-password -- "ваш-пароль"
ADMIN_PASSWORD_HASH=замените-на-bcrypt-хэш

# Необязательно: принудительно включить или выключить Secure-флаг у cookie.
# По умолчанию он включается сам при NODE_ENV=production. Ставьте false,
# только если продакшен временно работает по http (тогда сессия уязвима
# к перехвату — это временная мера).
# COOKIE_SECURE=true
