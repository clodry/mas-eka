# Скопируйте в .env на VPS и замените все значения-заглушки.
# Используйте длинные случайные шестнадцатеричные строки для паролей БД и сессии.
SITE_DOMAIN=ваш-домен.ru
NODE_ENV=production
# Дополнительные собственные origin через запятую. Для остальных CORS закрыт.
# CORS_ORIGINS=https://www.ваш-домен.ru

POSTGRES_DB=mas_eka
POSTGRES_USER=mas_eka
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_64_СИМВОЛА_HEX

SESSION_SECRET=ЗАМЕНИТЕ_НА_64_СИМВОЛА_HEX
ADMIN_LOGIN=eka_admin
# Сгенерируйте bcrypt-хэш локально: npm run hash-password -- "ваш_пароль"
# Обязательно заключите хэш в одинарные кавычки: '$2b$10$...'
ADMIN_PASSWORD_HASH='$2b$10$ВСТАВЬТЕ_СЮДА_BCRYPT_ХЭШ'
